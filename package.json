{
  "name": "true-godot",
  "displayName": "True Godot Theme",
  "description": "A faithful recreation of the Godot 4 editor and script editor colours, with support for GDScript, shaders and 40+ other languages",
  "version": "0.5.1",
  "publisher": "MrPogofu",
  "license": "MIT",
  "icon": "TrueGodotLogo.png",
  "galleryBanner": {
    "color": "#1D2229",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrPogofu/true-godot"
  },
  "keywords": [
    "godot",
    "godot engine",
    "godot 4",
    "godot 4 theme",
    "godot theme",
    "godot color theme",
    "godot dark theme",
    "godot editor",
    "gdscript",
    "gdscript theme",
    "gdshader",
    "godot shader",
    "game development",
    "game dev",
    "dark theme",
    "dark color theme",
    "vscode theme",
    "visual studio code theme",
    "syntax highlighting",
    "python",
    "c#",
    "csharp",
    "c++",
    "rust",
    "javascript",
    "typescript",
    "html",
    "css",
    "glsl",
    "shader"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "True Godot",
        "uiTheme": "vs-dark",
        "path": "./themes/True Godot-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.gdscript.godot-globals.injection",
        "path": "./syntaxes/gdscript-globals.injection.json",
        "injectTo": [
          "source.gdscript"
        ]
      }
    ]
  }
}
